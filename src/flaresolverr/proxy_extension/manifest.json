{
    "version": "1.0.0",
    "manifest_version": 3,
    "name": "FlareSolverr Proxy Manager",
    "permissions": [
        "proxy",
        "storage",
        "webRequest",
        "webRequestAuthProvider"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    }
}
